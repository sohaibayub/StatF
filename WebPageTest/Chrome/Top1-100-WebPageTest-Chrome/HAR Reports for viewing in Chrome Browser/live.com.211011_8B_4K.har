                            "line": "</script> </head> <body class=preload data-is-probably-mobile-os=\"\" data-likely-os=\"\"> <section name=mobile-speedbump id=mobile-speedbump role=alertdialog aria-labelledby=mobile-speedbump-slogan aria-modal=true aria-hidden=true> <div class=plate> <button tabindex=-1 class=mobile-speedbump-close data-m='{\"cN\":\"DISMISS\",\"sN\":\"P1\",\"pV\":\"1\"}'>Dismiss</button> <div class=plate-contents> <header class=slogan id=mobile-speedbump-slogan> <h1>Download the free Outlook experience designed for your phone</h1> </header> <div class=\"artwork lazy\" data-bg=\"url(https://ow2.res.office365.com/owalanding/2021.8.25.01/images/outlook-mobile-apps-ios.jpg)\" data-relevance=ios></div> <div class=\"artwork lazy\" data-bg=\"url(https://ow2.res.office365.com/owalanding/2021.8.25.01/images/outlook-mobile-apps-android.jpg)\" data-relevance=android></div> <ul class=advancement-choices> <li class=primary data-relevance=ios> <a tabindex=-1 data-m='{\"cN\":\"APPSTORE\",\"sN\":\"P1\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=2087918\" title=\"Download Outlook for iOS\" class=internal>Download Outlook for iOS</a> </li> <li class=primary data-relevance=android> <a tabindex=-1 data-m='{\"cN\":\"PLAYSTORE\",\"sN\":\"P1\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=2087917\" title=\"Download Outlook for Android\" class=internal>Download Outlook for Android</a> </li> <li class=secondary> <a tabindex=-1 data-m='{\"cN\":\"SIGNIN\",\"sN\":\"P1\",\"pV\":\"1\"}' href=\"./?nlp=1\" title=\"Sign in to your Outlook email\" class=\"internal sign-in-link\"> <span> <i>Continue to Outlook sign-in</i> <b aria-hidden=true class=glyph> <svg xmlns=\"http://www.w3.org/2000/svg\" width=32 height=35 viewBox=\"0 0 32 35\"> <g id=a0bb59d7-4ade-43d7-8506-5758cb0b6869 data-name=art> <path d=\"M2.62,31.93H18.3v2.24H.38V.58H18.3V2.82H2.62ZM32,17.38l-8.52,8.53-1.4-1.4,6-6H9.34V16.26H28.12l-6-6,1.4-1.4Z\"/> </g> </svg> </b> </span> </a> </li> </ul> </div> </div> <div class=screen> </div> </section> <aside id=msccBanner name=gdpr-banner> <div class=inner> <div class=\"content bound\"> <p> <span>This site uses cookies for analytics, personalized content and ads. By continuing to browse this site, you agree to this use.</span> <i aria-hidden=true></i> </p> <footer class=see-more> <a id=msccLearnMore data-m='{\"cN\":\"CONSENT\",\"sN\":\"P3\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=845480\">Learn more</a> </footer> </div> </div> </aside> <header class=masthead role=banner> <div class=masthead-shell> <div class=primary-content> <div class=\"titling bound\"> <h1 class=product-name> <span>Outlook</span> </h1> <p class=tagline> <span>Connect.</span> <span>Organize.</span> <span>Get things done.</span> </p> </div> <section class=\"precis above-fold\"> <div class=\"plate bound\"> <div class=prose> <h2>Free Outlook email and calendar</h2> <p>Everything you need to be your most productive and connected self—at home, on the go, and everywhere in between.</p> </div> <div class=action> <a data-m='{\"cN\":\"SIGNUP\",\"sN\":\"P4\",\"pV\":\"1\"}' href=\"https://outlook.live.com/owa/?nlp=1&signup=1\" class=internal><span>Create free account</span></a> </div> </div> </section> <div class=mobile-cta aria-hidden=true> <div class=bound> <h2>Free Outlook email and calendar</h2> <div class=action-wrapper> <div class=action> <a data-m='{\"cN\":\"SIGNUP\",\"sN\":\"P5\",\"pV\":\"1\"}' href=\"https://outlook.live.com/owa/?nlp=1&signup=1\" class=internal><span>Create free account</span></a> </div> </div> </div> </div> </div> <aside class=static-strip> <div class=bound> <mark class=corp-name><a data-m='{\"cN\":\"MICROSOFT\",\"sN\":\"P6\",\"pV\":\"1\"}' href=\"https://www.microsoft.com\" title=\"Microsoft\">Microsoft</a></mark> <nav class=auxiliary-actions aria-label=\"Quick links\"> <ul> <li><a data-m='{\"cN\":\"PREMIUM\",\"sN\":\"P6\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=2005900&WT.mc_id=PROD_OL-Web_PreAuth_May19UI\">Try premium</a></li> <li><a data-m='{\"cN\":\"SIGNIN\",\"sN\":\"P6\",\"pV\":\"1\"}' href=\"./?nlp=1\" class=\"internal sign-in-link\" data-task=signin>Sign in</a></li> </ul> </nav> </div> </aside> </div> </header> <div class=extraneous-descriptive-summary aria-hidden=true> <div class=bound> <p>Everything you need to be your most productive and connected self—at home, on the go, and everywhere in between.</p> </div> </div> <aside id=conditional-app-appeal name=conditional-app-appeal aria-labelledby=mobile-appeal-headline> <div class=bound> <figure class=mobile-app-hero> <div class=\"device-photograph lazy ios\" data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/outlook-mobile-apps-ios.jpg\")> <div class=fill> </div> </div> <div class=\"device-photograph lazy android\" data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/outlook-mobile-apps-android.jpg\")> <div class=fill> </div> </div> <figcaption> <h1 id=mobile-appeal-headline>Download the free Outlook app for your phone.</h1> <a data-m='{\"cN\":\"APPSTORE\",\"sN\":\"P7\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=2087916\" class=\"app-store-outbound ios internal\">Download Outlook for iOS</a> <a data-m='{\"cN\":\"PLAYSTORE\",\"sN\":\"P7\",\"pV\":\"1\"}' href=\"https://go.microsoft.com/fwlink/?linkid=2087714\" class=\"app-store-outbound android internal\">Download Outlook for Android</a> </figcaption> </figure> </div> </aside> <main role=main> <section class=block id=a-simple-experience name=a-simple-experience aria-labelledby=one-place-headline> <header> <div class=media> <div class=bound> <div class=\"photo lazy\" data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/efficient-commuter.jpg\")> </div> </div> </div> <div class=text> <div class=bound> <div class=plate> <h1><span id=one-place-headline>Email and calendar, together in one place</span></h1> <p>Stay on top of your most important messages and events.</p> </div> </div> </div> </header> <div class=tour-the-interface> <div class=bound> <div class=interface-arcade-cabinet> <div class=\"monitor lazy\" data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/everything-in-one-place-scenario-base.png\")> <div class=fill> <div class=scenarios> <div class=\"scenario lazy\" data-scenario=2 data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/everything-in-one-place-scenario-02.png\")></div> <div class=\"scenario lazy\" data-scenario=3 data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/everything-in-one-place-scenario-03.png\")></div> <div class=\"scenario lazy\" data-scenario=4 data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/everything-in-one-place-scenario-04.png\")></div> <div class=\"scenario lazy\" data-scenario=5 data-src=\"https://ow2.res.office365.com/owalanding/2021.8.25.01/images/everything-in-one-place-scenario-05.png\")></div> </div> </div> </div> <div class=controller> <ul class=buttons-track role=list aria-label=\"The five features of Outlook\"> <li class=default tabindex=0 role=listitem aria-labelledby=one-place-feature-title-a aria-describedby=one-place-feature-desc-a> <i aria-hidden=true class=beak></i> <i aria-hidden=true class=icon><svg xmlns=\"http://www.w3.org/2000/svg\" width=27 height=22 viewBox=\"0 0 27 22\" class=some-class> <title>one-place-interface-icon-email</title> <g id=be0fac28-4977-410c-965b-f58f2a1521e2 data-name=\"export stash\"> <path d=\"M24.7,4V18H2.3V4ZM23.3,16.6V6.89l-9.8,4.89L3.7,6.89V16.6ZM3.86,5.4l9.64,4.82L23.14,5.4Z\"></path> </g> </svg> </i> <mark aria-hidden=true class=label id=one-place-feature-title-a>Email</mark> </li> <li tabindex=0 role=listitem aria-labelledby=one-place-feature-title-b aria-describedby=one-place-feature-desc-b> <i aria-hidden=true class=beak></i> <i aria-hidden=true class=icon><svg xmlns=\"http://www.w3.org/2000/svg\" width=27 height=22 viewBox=\"0 0 27 22\" class=some-cla